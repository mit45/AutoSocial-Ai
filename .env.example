# Copy this file to .env and fill the values. Do NOT commit real secrets.

# OpenAI
OPENAI_API_KEY=

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# App & Uploads
BASE_URL=https://example.com
UPLOAD_BASE_URL=https://example.com/uploads/ig
UPLOAD_API_URL=
UPLOAD_API_KEY=

# FTP (optional, if you use FTP upload fallback)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Cloudflare R2 (optional)
# If set, generated images will be uploaded to R2 instead of FTP.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public base URL (e.g. https://cdn.umittopuz.com/ig) to construct public image URLs
R2_PUBLIC_BASE_URL=

# Database (default: local sqlite)
DATABASE_URL=sqlite:///./autosocial.db

# ----------------------------------------------------------------------------
# Authentication & Encryption (ZORUNLU - üretimde mutlaka doldurun)
# ----------------------------------------------------------------------------
# JWT imzası için rastgele uzun bir string (ör. 64+ karakter).
SECRET_KEY=
# Hassas alanların şifrelenmesi için. Tercihen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# çıktısını yapıştırın. Değiştirirseniz daha önce şifrelenmiş veriler çözülemez!
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Geliştirme modunda auth'u devre dışı bırakmak için 0 (üretim: 1).
AUTH_REQUIRED=1

# İlk kurulumda otomatik admin oluşturmak istersen doldur (opsiyonel).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

